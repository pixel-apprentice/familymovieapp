{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "X-Frame-Options", "value": "ALLOWALL" },
                { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://*.google.com" }
            ]
        }
    ]
}